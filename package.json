{
  "name": "mission-expenses",
  "productName": "سامانه هزینه ماموریت",
  "version": "1.0.0",
  "description": "سامانه مدیریت و پیگیری هزینه‌های ماموریت اداری",
  "private": true,
  "main": "electron/main.js",
  "author": {
    "name": "aliajeli"
  },
  "license": "MIT",
  "scripts": {
    "dev:next": "next dev -p 3000",
    "dev": "concurrently -k \"next dev -p 3000\" \"wait-on tcp:3000 && cross-env NODE_ENV=development electron .\"",
    "build:next": "next build",
    "start:electron": "electron .",
    "dist": "next build && electron-builder --win --publish never",
    "lint": "next lint"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "next": "15.5.26",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "wait-on": "^8.0.1"
  }
}
